+#[tokio::test]
+async fn cyber_policy_error_continues_an_active_goal_with_daybreak_enabled() -> Result<()> {
+    let empty_response = |id: &str| {
+        let mut empty_final = responses::ev_assistant_message(&format!("{id}-empty"), "");
+        empty_final["item"]["phase"] = json!("final_answer");
+        responses::sse(vec![
+            responses::ev_response_created(id),
+            empty_final,
+            responses::ev_completed(id),
+        ])
+    };
+    let mut cyber_empty_final = responses::ev_assistant_message("cyber-policy-empty", "");
+    cyber_empty_final["item"]["phase"] = json!("final_answer");
+    let server = create_mock_responses_server_sequence(vec![
+        empty_response("empty-1"),
+        empty_response("empty-2"),
+        responses::sse(vec![
+            responses::ev_response_created("cyber-policy"),
+            cyber_empty_final,
+            json!({
+                "type": "response.failed",
+                "response": {
+                    "id": "cyber-policy",
+                    "error": {
+                        "code": "cyber_policy",
+                        "message": "This request was flagged for cyber policy."
+                    }
+                }
+            }),
+        ]),
+        responses::sse(vec![
+            responses::ev_response_created("complete-goal"),
+            responses::ev_function_call(
+                "complete-goal-call",
+                "update_goal",
+                r#"{"status":"complete"}"#,
+            ),
+            responses::ev_completed("complete-goal"),
+        ]),
+        responses::sse(vec![
+            responses::ev_response_created("final"),
+            responses::ev_assistant_message("final-message", "Goal complete."),
+            responses::ev_completed("final"),
+        ]),
+    ])
+    .await;
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_model("gpt-5.4")
+        .enable_feature(Feature::Goals)
+        .write(codex_home.path())?;
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .without_managed_config()
+        .build_initialized()
+        .await?;
+    let request = mcp
+        .send_thread_start_request_with_auto_env(ThreadStartParams {
+            daybreak_enabled: Some(true),
+            ..Default::default()
+        })
+        .await?;
+    let ThreadStartResponse { thread, .. } = mcp.read_response(request).await?;
+    assert_eq!(Some(true), thread.daybreak_enabled);
+    let request = mcp
+        .send_raw_request(
+            "thread/goal/set",
+            Some(json!({"threadId": thread.id, "objective": "Finish the work"})),
+        )
+        .await?;
+    let _: ThreadGoalSetResponse = mcp.read_response(request).await?;
+
+    for _ in 0..2 {
+        let empty: TurnCompletedNotification = timeout(
+            Duration::from_secs(30),
+            mcp.read_notification("turn/completed"),
+        )
+        .await??;
+        assert_eq!(TurnStatus::Completed, empty.turn.status);
+    }
+
+    let failed: TurnCompletedNotification = timeout(
+        Duration::from_secs(30),
+        mcp.read_notification("turn/completed"),
+    )
+    .await??;
+    assert_eq!(TurnStatus::Failed, failed.turn.status);
+
+    let continued: TurnCompletedNotification = timeout(
+        Duration::from_secs(30),
+        mcp.read_notification("turn/completed"),
+    )
+    .await??;
+    assert_eq!(TurnStatus::Completed, continued.turn.status);
+
+    server.verify().await;
+    Ok(())
+}
