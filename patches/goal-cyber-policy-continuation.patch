+async fn active_goal_cyber_policy_picker_shows_once_without_pausing_continuation() {
+    let (mut chat, mut events, _ops) = make_chatwidget_manual_with_auth(
+        Some("gpt-5.6-sol"),
+        /*has_chatgpt_account*/ true,
+        /*has_codex_backend_auth*/ true,
+        FrameRequester::test_dummy(),
+    )
+    .await;
+    chat.set_feature_enabled(Feature::CliDaybreak, /*enabled*/ true);
+    chat.set_feature_enabled(Feature::Goals, /*enabled*/ true);
+    let thread_id = ThreadId::new();
+    chat.thread_id = Some(thread_id);
+    update_thread_goal(&mut chat, thread_id, AppThreadGoalStatus::Active);
+
+    let mut model = crate::test_support::TEST_MODEL_PRESETS[0].clone();
+    model.model = "gpt-5.6-sol".into();
+    model.available_access_programs = Some(codex_protocol::openai_models::ModelAccessPrograms {
+        daybreak_availability: Default::default(),
+        cyber: vec![codex_protocol::turn_input::CyberAccessProgram::DaybreakBlue],
+    });
+    chat.model_catalog = std::sync::Arc::new(ModelCatalog::new(vec![model]));
+
+    handle_turn_started(&mut chat, "goal-turn");
+    handle_error(
+        &mut chat,
+        "server fallback message",
+        Some(CodexErrorInfo::CyberPolicy),
+    );
+
+    let cells = drain_insert_history(&mut events);
+    assert!(
+        cells
+            .iter()
+            .map(|lines| lines_to_single_string(lines))
+            .any(|rendered| rendered.contains("This content can’t be shown"))
+    );
+    assert!(!chat.bottom_pane.no_modal_or_popup_active());
+    assert!(!chat.input_queue.suppress_queue_autosend);
+
+    chat.handle_key_event(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE));
+    assert!(chat.bottom_pane.no_modal_or_popup_active());
+
+    handle_turn_started(&mut chat, "goal-turn-2");
+    handle_error(
+        &mut chat,
+        "server fallback message",
+        Some(CodexErrorInfo::CyberPolicy),
+    );
+    assert!(chat.bottom_pane.no_modal_or_popup_active());
+    assert!(!chat.input_queue.suppress_queue_autosend);
+}
